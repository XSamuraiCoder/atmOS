# ----------------------------
# atmOS picture wallpaper mods: CEdev project
# ----------------------------
#
# `make` builds one self-contained mod per picture: bin/WPDUNES.8xv, bin/WPLAKE.8xv and
# bin/WPAURORA.8xv. Each is the mod code (src/main.c, built with -DPIC=n), its relocation table,
# then the picture + theme data (data/<name>.bin, from tools/gen_wallpapers.py). Only the code
# is loaded into RAM; the mod reads its picture in place, so the AppVars are archived.
# atmOS finds a mod by the "atmOS mod: <name>" header in its data, not by the AppVar name - but
# these mods find their own picture by AppVar name, so keep NAME in sync with src/main.c.

ifeq ($(PIC),)

# ---- driver: build each picture's mod in its own make run (own obj/ folder and -DPIC) ----
.DEFAULT_GOAL := all
.PHONY: all appvar clean
all appvar:
	$(MAKE) PIC=0 NAME=WPDUNES  PICDATA=data/dunes.bin
	$(MAKE) PIC=1 NAME=WPLAKE   PICDATA=data/lake.bin
	$(MAKE) PIC=2 NAME=WPAURORA PICDATA=data/aurora.bin
clean:
	$(MAKE) PIC=0 NAME=WPDUNES  clean
	$(MAKE) PIC=1 NAME=WPLAKE   clean
	$(MAKE) PIC=2 NAME=WPAURORA clean

else

DESCRIPTION ?= "Picture wallpaper for atmOS"
ARCHIVED ?= YES
OBJDIR := obj/$(NAME)

# Most memory a mod may need (image + .bss). Keep in sync with MODS_MAX_MEM in the shell's mods.h.
MAX_MEM ?= 16384

# Python 3, used by tools/mkmod.py to build the relocation table.
PYTHON ?= python

# The mod is linked with its own script, generated below: address 0, header first, no crt0.
LINKER_SCRIPT ?= mod.ld
EXTRA_CLEAN = $(call RM,$(LINKER_SCRIPT))

CFLAGS   = -Wall -Wextra -Oz -ffreestanding -fno-builtin -DPIC=$(PIC)
CXXFLAGS = -Wall -Wextra -Oz

# ----------------------------

# same way the atmOS shell's Makefile finds CEdev (cedev-config must be on PATH)
include $(shell cedev-config --makefile)

# ---- output is an AppVar (.8xv), not a program (.8xp) ----
MOD_ELF := $(BINDIR)/$(NAME).elf
MOD_IMG := $(BINDIR)/$(NAME).img
MOD_BIN := $(BINDIR)/$(NAME).bin
MOD_FULL := $(BINDIR)/$(NAME).full
MOD_VAR := $(BINDIR)/$(NAME).8xv

ifeq ($(ARCHIVED),YES)
MOD_VAR_FLAGS := -r
endif

.DEFAULT_GOAL := appvar
.PHONY: appvar
appvar: $(MOD_VAR)

# ---- the linker script, generated into $(LINKER_SCRIPT) ----
# Written with plain echo lines so it works with any make (Windows ships GNU Make 3.81) and
# with cmd.exe: the script avoids & | > and uses ^< (escaped) on Windows. The image is linked at
# address 0, so every address in it is an offset; the 32-byte header (ATMOS_MOD_HEADER, section
# .modhdr) goes first. mod_image_end / mod_bss_end are read by the header. C symbols carry a
# leading underscore in CEdev.
ifeq ($(OS),Windows_NT)
ESC := ^
LDLINE = echo $1 >> $@
else
ESC :=
LDLINE = echo '$1' >> $@
endif

$(LINKER_SCRIPT): $(MAKEFILE_LIST)
	$(Q)$(call RM,$@)
	$(Q)$(call LDLINE,/* atmOS mod linker script: generated by the Makefile. */)
	$(Q)$(call LDLINE,ENTRY(_mod_main))
	$(Q)$(call LDLINE,SECTIONS)
	$(Q)$(call LDLINE,{)
	$(Q)$(call LDLINE,  .image 0 : {)
	$(Q)$(call LDLINE,    KEEP(*(.modhdr)))
	$(Q)$(call LDLINE,    *(.text .text.*))
	$(Q)$(call LDLINE,    *(.rodata .rodata.*))
	$(Q)$(call LDLINE,    *(.data .data.*))
	$(Q)$(call LDLINE,    _mod_image_end = .;)
	$(Q)$(call LDLINE,  })
	$(Q)$(call LDLINE,  .bss (NOLOAD) : {)
	$(Q)$(call LDLINE,    *(.bss .bss.*))
	$(Q)$(call LDLINE,    *(COMMON))
	$(Q)$(call LDLINE,    _mod_bss_end = .;)
	$(Q)$(call LDLINE,  })
	$(Q)$(call LDLINE,  /DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) })
	$(Q)$(call LDLINE,})
	$(Q)$(call LDLINE,ASSERT(_mod_bss_end $(ESC)<= $(MAX_MEM)$(comma) mod_needs_more_memory_than_MAX_MEM))

# Link the compiled objects ($(OBJECTS) = obj/lto.o) directly, with the same ld flags makefile.mk
# uses for programs, but our own entry point and linker script. Not obj/<NAME>.o: makefile.mk
# builds that with --entry=__start, so it garbage-collects everything in a mod.
# -q keeps the relocations so mkmod.py can build the table.
$(MOD_ELF): $(OBJECTS) $(LINKER_SCRIPT) $(MAKEFILE_LIST) $(DEPS)
	$(Q)$(call MKDIR,$(@D))
	$(Q)echo [linking] $@
	$(Q)$(LD) \
		-static \
		--entry=_mod_main \
		--no-warn-rwx-segments \
		--no-warn-execstack \
		--gc-sections \
		--omagic \
		-q \
		-T$(LINKER_SCRIPT) \
		-Map=$(BINDIR)/$(NAME).map \
		$(OBJECTS) \
		--start-group $(LIB_CRT) --end-group \
		-o $(call QUOTE_ARG,$@)

$(MOD_IMG): $(MOD_ELF)
	$(Q)$(OBJCOPY) -O binary $< $@

# image + relocation table (and the header's relocation count)
$(MOD_BIN): $(MOD_IMG) $(MOD_ELF) tools/mkmod.py
	$(Q)$(PYTHON) tools/mkmod.py $(MOD_ELF) $(MOD_IMG) $@ --max-mem $(MAX_MEM)

# mod (code + relocation table), then the picture data the mod reads in place
$(MOD_FULL): $(MOD_BIN) $(PICDATA)
	$(Q)$(PYTHON) -c "import sys; open(sys.argv[3], 'wb').write(open(sys.argv[1], 'rb').read() + open(sys.argv[2], 'rb').read())" $(MOD_BIN) $(PICDATA) $@

$(MOD_VAR): $(MOD_FULL)
	$(Q)$(CONVBIN) -j bin -k 8xv -n $(NAME) $(MOD_VAR_FLAGS) -i $< -o $@

endif
